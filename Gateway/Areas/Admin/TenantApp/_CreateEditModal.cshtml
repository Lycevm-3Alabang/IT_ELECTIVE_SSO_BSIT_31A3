@model Gateway.Areas.Admin.Models.TenantApps.TenantAppViewModel
@{
    var isEdit = Model.Id != 0;
}

<form asp-area="Admin" asp-controller="TenantApp" asp-action="@(isEdit ? "Edit" : "Create")"
      asp-route-id="@(isEdit ? Model.Id : (int?)null)" method="post" novalidate>
    <div class="modal-header">
        <h5 class="modal-title">@(isEdit ? "Edit App" : "Register App")</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
        <input type="hidden" asp-for="Id" />

        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Finance Portal" autocomplete="off" />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ReturnUrl" class="form-label"></label>
            <input asp-for="ReturnUrl" class="form-control" placeholder="https://app.example.com/sso/callback" />
            <span asp-validation-for="ReturnUrl" class="text-danger small"></span>
        </div>

        <div class="form-check form-switch">
            <input asp-for="IsEnabled" class="form-check-input" role="switch" />
            <label asp-for="IsEnabled" class="form-check-label"></label>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Register")</button>
    </div>
</form>
