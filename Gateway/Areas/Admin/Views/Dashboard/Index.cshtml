@model Gateway.Areas.Admin.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <div>
        <h2>Dashboard</h2>
        <p>Overview of your SSO gateway</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card stat-card--yellow">
            <div class="card-body">
                <div>
                    <p class="stat-label">Total Users</p>
                    <p class="stat-value">@Model.TotalUsers</p>
                </div>
                <div class="stat-icon"><i class="bi bi-people"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card stat-card--blue">
            <div class="card-body">
                <div>
                    <p class="stat-label">Active Users</p>
                    <p class="stat-value">@Model.ActiveUsers</p>
                </div>
                <div class="stat-icon"><i class="bi bi-person-check"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card stat-card--yellow">
            <div class="card-body">
                <div>
                    <p class="stat-label">Total Apps</p>
                    <p class="stat-value">@Model.TotalApps</p>
                </div>
                <div class="stat-icon"><i class="bi bi-app-indicator"></i></div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card stat-card stat-card--blue">
            <div class="card-body">
                <div>
                    <p class="stat-label">Total Groups</p>
                    <p class="stat-value">@Model.TotalGroups</p>
                </div>
                <div class="stat-icon"><i class="bi bi-diagram-3"></i></div>
            </div>
        </div>
    </div>
</div>

<div class="card quick-links shadow-sm">
    <div class="card-header">Quick links</div>
    <div class="card-body d-flex flex-wrap gap-2">
        <a class="btn btn-primary" asp-area="Admin" asp-controller="TenantApps" asp-action="Index"><i class="bi bi-app-indicator me-1"></i> Manage Apps</a>
        <a class="btn btn-outline-primary" asp-area="" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-1"></i> Users</a>
        <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Groups" asp-action="Index"><i class="bi bi-diagram-3 me-1"></i> Groups</a>
        <a class="btn btn-outline-primary" asp-area="" asp-controller="Audit" asp-action="Index"><i class="bi bi-journal-text me-1"></i> Audit Logs</a>
    </div>
</div>
