@model GroupFormViewModel
@{
    ViewData["Title"] = "Edit Group";
}

<h2 class="mb-4">Edit Group</h2>

<div class="row">
    <div class="col-lg-6">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" id="groupForm" data-app-name="@Model.AppName">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <input type="hidden" asp-for="TenantAppId" />

            <div class="mb-3">
                <label class="form-label">App</label>
                <input type="text" class="form-control" value="@Model.AppName" readonly />
                <div class="form-text">A group stays with its app, so this can't be changed.</div>
            </div>

            <div class="mb-3">
                <label asp-for="GroupName" class="form-label"></label>
                <input asp-for="GroupName" class="form-control" autocomplete="off" required />
                <span asp-validation-for="GroupName" class="text-danger small"></span>
                <div class="form-text">
                    Saved as: <code id="groupNamePreview"></code>
                </div>
            </div>

            <div class="mb-4">
                <label asp-for="PowerLevel" class="form-label"></label>
                <input asp-for="PowerLevel" type="number" class="form-control" min="0" max="100" step="1" required />
                <span asp-validation-for="PowerLevel" class="text-danger small"></span>
                <div class="form-text">
                    Whole number from 0 to 100. <strong>0 = highest power</strong>; higher numbers = less power.
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-check-lg me-1"></i> Save changes
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin-groups.js"></script>
}
