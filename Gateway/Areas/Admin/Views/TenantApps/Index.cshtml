@model IEnumerable<Gateway.Models.ExternalApp>

@{
    ViewData["Title"] = "Tenant App Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Tenant App Management</h2>
    <a asp-area="Admin" asp-controller="TenantApps" asp-action="Create" class="btn btn-primary">+ Register New App</a>
</div>

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["StatusMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Return URL</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-4 text-muted">No external applications registered.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">@item.Name</td>
                            <td><code>@item.ReturnUrl</code></td>
                            <td>
                                @if (item.IsEnabled)
                                {
                                    <span class="badge bg-success">Enabled</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Disabled</span>
                                }
                            </td>
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-primary js-open-app"
                                        data-app-name="@item.Name"
                                        data-app-url="@item.ReturnUrl"
                                        disabled="@(!item.IsEnabled)"
                                        title="@(item.IsEnabled ? "Open this app in a new tab" : "Enable the app to open it")">
                                    Open
                                </button>
                                
                                <form asp-area="Admin" asp-controller="TenantApps" asp-action="ToggleStatus" asp-route-id="@item.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm @(item.IsEnabled ? "btn-outline-warning" : "btn-outline-success")">
                                        @(item.IsEnabled ? "Disable" : "Enable")
                                    </button>
                                </form>

                                
                                <a asp-area="Admin" asp-controller="TenantApps" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary ms-1">Edit</a>

                                
                                <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteModal-@item.Id">
                                    Delete
                                </button>

                                <!-- Render Delete Modal Partial for this row -->
                                <partial name="_DeleteConfirmModal" model="item" />
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Confirmation shown before an app is opened in a new tab -->
<div class="modal fade" id="openAppModal" tabindex="-1" aria-labelledby="openAppModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="openAppModalLabel">Open application</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>You are about to open <strong id="openAppName"></strong> in a new tab.</p>
                <p class="text-muted small mb-0">Address: <code id="openAppUrl"></code></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="openAppConfirm">Continue</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var modalEl = document.getElementById('openAppModal');
            var modal = new bootstrap.Modal(modalEl);
            var nameEl = document.getElementById('openAppName');
            var urlEl = document.getElementById('openAppUrl');
            var pendingUrl = null;

            document.querySelectorAll('.js-open-app').forEach(function (button) {
                button.addEventListener('click', function () {
                    pendingUrl = button.getAttribute('data-app-url');
                    nameEl.textContent = button.getAttribute('data-app-name');
                    urlEl.textContent = pendingUrl;
                    modal.show();
                });
            });

            document.getElementById('openAppConfirm').addEventListener('click', function () {
                // Registered addresses are http(s) only; check again before leaving the admin console.
                if (pendingUrl && /^https?:\/\//i.test(pendingUrl)) {
                    window.open(pendingUrl, '_blank', 'noopener,noreferrer');
                }
                pendingUrl = null;
                modal.hide();
            });
        })();
    </script>
}
