<div class="modal fade" id="resetPasswordModal" tabindex="-1" aria-labelledby="resetPasswordModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="resetPasswordModalLabel">Reset Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <!-- Step 1: confirmation -->
                <div id="resetPasswordConfirmStep">
                    <p>
                        Are you sure you want to reset the password for
                        <strong id="resetPasswordModalEmail"></strong>?
                    </p>
                    <p class="text-muted small mb-0">
                        A new temporary password will be generated. The user's current password
                        will stop working immediately.
                    </p>
                </div>

                <!-- Step 2: result (hidden until reset succeeds) -->
                <div id="resetPasswordResultStep" class="d-none">
                    <p class="mb-2">
                        Password reset for <strong id="resetPasswordResultEmail"></strong>.
                        Share this temporary password with the user securely - it won't be shown again.
                    </p>
                    <label for="temporaryPasswordField" class="form-label small text-muted">Temporary password</label>
                    <div class="input-group mb-2">
                        <input type="text" id="temporaryPasswordField" class="form-control font-monospace" readonly>
                        <button type="button" id="copyTemporaryPasswordBtn" class="btn btn-outline-secondary">
                            <i class="bi bi-clipboard"></i> Copy to Clipboard
                        </button>
                    </div>
                    <div id="copyPasswordFeedback" class="form-text text-success d-none">Copied!</div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" id="resetPasswordCancelBtn" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button type="button" id="resetPasswordConfirmBtn" class="btn btn-warning">
                    <i class="bi bi-key me-1"></i> Reset Password
                </button>
                <button type="button" id="resetPasswordDoneBtn" class="btn btn-primary d-none" data-bs-dismiss="modal">
                    Done
                </button>
            </div>
        </div>
    </div>
</div>
