@model Gateway.Areas.Admin.Models.Users.UserDetailsViewModel
@{
    ViewData["Title"] = "User Details";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">User Details</h2>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i> Back to Users
    </a>
</div>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @statusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div id="userAlerts"></div>

<div class="card shadow-sm" style="max-width: 640px;">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                    @(Model.IsActive ? "Active" : "Inactive")
                </span>
            </dd>

            <dt class="col-sm-4">Groups</dt>
            <dd class="col-sm-8">
                @if (Model.Groups.Any())
                {
                    foreach (var group in Model.Groups)
                    {
                        <span class="badge bg-light text-dark border me-1">@group.GroupName</span>
                    }
                }
                else
                {
                    <span class="text-muted">No groups assigned</span>
                }
            </dd>

            <dt class="col-sm-4">Created</dt>
            <dd class="col-sm-8">@Model.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</dd>

            <dt class="col-sm-4">Last Login</dt>
            <dd class="col-sm-8">
                @(Model.LastLoginAt.HasValue
                    ? Model.LastLoginAt.Value.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                    : "Never logged in")
            </dd>
        </dl>
    </div>
    <div class="card-footer d-flex justify-content-end gap-2">
        <div class="form-check form-switch d-flex align-items-center me-auto">
            <input type="checkbox" class="form-check-input js-toggle-active" role="switch"
                   id="detailsActiveToggle"
                   data-user-id="@Model.Id"
                   data-toggle-url="@Url.Action("ToggleActive", new { id = Model.Id })"
            @(Model.IsActive ? "checked" : "") />
            <label class="form-check-label ms-2" for="detailsActiveToggle">Active</label>
        </div>
        <button type="button" class="btn btn-outline-warning js-reset-password-trigger"
                data-bs-toggle="modal" data-bs-target="#resetPasswordModal"
                data-reset-url="@Url.Action("ResetPassword", new { id = Model.Id })"
                data-user-email="@Model.Email">
            <i class="bi bi-key me-1"></i> Reset Password
        </button>
        <button type="button" class="btn btn-outline-danger js-delete-trigger"
                data-bs-toggle="modal" data-bs-target="#deleteUserModal"
                data-delete-url="@Url.Action("Delete", new { id = Model.Id })"
                data-user-email="@Model.Email">
            <i class="bi bi-trash me-1"></i> Delete User
        </button>
    </div>
</div>

<div class="card shadow-sm mt-3" style="max-width: 640px;" id="groupAssignments">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Group assignments</span>
        <small class="text-muted">0 = highest power; higher = less power</small>
    </div>
    <ul id="userGroupList" class="list-group list-group-flush">
        <li class="list-group-item text-muted small js-no-groups @(Model.Groups.Any() ? "d-none" : "")">No groups assigned</li>
        @foreach (var group in Model.Groups)
        {
            <li class="list-group-item d-flex justify-content-between align-items-center" data-group-id="@group.GroupId">
                <div>
                    <strong>@group.GroupName</strong>
                    <div class="small text-muted">
                        App: @group.AppName &middot;
                        <span class="badge @(group.PowerLevel == 0 ? "bg-danger" : "bg-secondary")">Level @group.PowerLevel</span>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger js-unassign-group"
                        data-unassign-url="@Url.Action("Unassign", "UserGroups", new { area = "Admin", userId = Model.Id, groupId = group.GroupId })"
                        data-group-name="@group.GroupName">
                    <i class="bi bi-x-lg"></i> Remove
                </button>
            </li>
        }
    </ul>
    <div class="card-footer">
        @if (!Model.AvailableGroups.Any())
        {
            <span class="text-muted small">
                @(Model.Groups.Any() ? "This user is in every available group." : "No groups exist yet.")
                <a asp-area="Admin" asp-controller="Groups" asp-action="Index">Manage groups</a>
            </span>
        }
        else
        {
            <form asp-area="Admin" asp-controller="UserGroups" asp-action="Assign" asp-route-userId="@Model.Id" method="post" class="d-flex gap-2">
                <select name="groupId" class="form-select" aria-label="Group to assign" required>
                    <option value="">Select a group to assign&hellip;</option>
                    @foreach (var appGroups in Model.AvailableGroups.GroupBy(g => g.AppName))
                    {
                        <optgroup label="@appGroups.Key">
                            @foreach (var option in appGroups)
                            {
                                <option value="@option.GroupId">@option.GroupName (level @option.PowerLevel)</option>
                            }
                        </optgroup>
                    }
                </select>
                <button type="submit" class="btn btn-primary text-nowrap">
                    <i class="bi bi-plus-lg me-1"></i> Assign
                </button>
            </form>
        }
    </div>
</div>

<div class="card shadow-sm mt-3" style="max-width: 640px;">
    <div class="card-header">Recent Activity</div>
    <ul id="auditLogList" class="list-group list-group-flush">
        @if (!Model.RecentActivity.Any())
        {
            <li class="list-group-item text-muted small">No activity recorded yet.</li>
        }
        else
        {
            foreach (var entry in Model.RecentActivity)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center small">
                    <span>@entry.Action</span>
                    <span class="text-muted">@entry.Timestamp.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</span>
                </li>
            }
        }
    </ul>
</div>

@await Html.PartialAsync("_DeleteConfirmModal")
@await Html.PartialAsync("_ResetPasswordModal")

@section Scripts {
    <form id="antiForgeryForm">@Html.AntiForgeryToken()</form>
    <script src="~/js/admin-users.js"></script>
    <script src="~/js/admin-user-groups.js"></script>
}
