@model Gateway.Models.Admin.AuditLogListViewModel
@{ ViewData["Title"] = "Audit Logs"; }
<div class="d-flex justify-content-between align-items-center mb-3"><h1>Audit Logs</h1><a class="btn btn-outline-secondary" asp-controller="Users" asp-action="Index">Users</a></div>
<form method="get" class="row g-3 mb-4">
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
    <div class="col-md-3"><label for="from" class="form-label">From</label><input id="from" name="from" type="date" class="form-control" value="@(Model.From?.ToString("yyyy-MM-dd"))" /></div>
    <div class="col-md-3"><label for="to" class="form-label">To</label><input id="to" name="to" type="date" class="form-control" value="@(Model.To?.ToString("yyyy-MM-dd"))" /></div>
    <div class="col-md-3 d-flex align-items-end gap-2"><button type="submit" class="btn btn-primary">Filter</button><a asp-action="Index" class="btn btn-outline-secondary">Clear</a></div>
</form>
<div class="table-responsive"><table class="table table-striped table-sm align-middle"><thead><tr><th>Timestamp (UTC)</th><th>Action</th><th>User / Email</th><th>Reason</th><th>IP Address</th><th>Details</th></tr></thead><tbody>
@foreach (var log in Model.Logs) { <tr><td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td><td><span class="badge bg-secondary">@log.Action</span></td><td>@(log.Email ?? log.UserId ?? "System/Unknown")</td><td>@(log.Reason ?? "-")</td><td>@(log.IpAddress ?? "N/A")</td><td>@log.Details</td></tr> }
@if (!Model.Logs.Any()) { <tr><td colspan="6" class="text-center text-muted">No audit logs found.</td></tr> }
</tbody></table></div>
<nav aria-label="Audit logs pagination"><ul class="pagination">
<li class="page-item @(Model.HasPreviousPage ? "" : "disabled")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))" asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))">Previous</a></li>
<li class="page-item disabled"><span class="page-link">Page @Model.Page of @Model.TotalPages</span></li>
<li class="page-item @(Model.HasNextPage ? "" : "disabled")"><a class="page-link" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-from="@(Model.From?.ToString("yyyy-MM-dd"))" asp-route-to="@(Model.To?.ToString("yyyy-MM-dd"))">Next</a></li>
</ul></nav>
