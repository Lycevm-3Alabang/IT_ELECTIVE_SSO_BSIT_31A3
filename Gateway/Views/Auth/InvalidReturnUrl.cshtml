@{
    ViewData["Title"] = "Can't sign you in";
}
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="alert alert-danger" role="alert">
            <h1 class="h4 alert-heading">We can't send you back to that app</h1>
            <p class="mb-0">
                The address you came from isn't registered with this sign-in service, or the app has been turned off.
                Return to the app and start the sign-in again. If it keeps happening, ask an administrator to check the app's registration.
            </p>
        </div>
    </div>
</div>
