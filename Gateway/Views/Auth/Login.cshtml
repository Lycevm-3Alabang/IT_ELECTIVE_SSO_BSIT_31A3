@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Login - IT ELECTIVE - SSO</title>
</head>

<body>

    <main>
        <h1>Login</h1>

        <form method="post">
            <div>
                <label for="email">Email</label>
                <input type="email"
                       id="email"
                       name="email"
                       required />
            </div>

            <div>
                <label for="password">Password</label>
                <input type="password"
                       id="password"
                       name="password"
                       required />
            </div>

            <button type="submit">
                Sign In
            </button>
        </form>
    </main>

</body>
</html>