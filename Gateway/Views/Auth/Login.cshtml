@{
    ViewData["Title"] = "IT ELECTIVE - SSO";
    ViewData["IsLoginPage"] = true;

    var returnUrl = ViewData["ReturnUrl"] as string;

    string? appName = null;

    if (!string.IsNullOrWhiteSpace(returnUrl) &&
        Uri.TryCreate(returnUrl, UriKind.Absolute, out var uri))
    {
        appName = uri.Host;
    }
}

<nav class="login-navbar"
     aria-label="Main navigation">

    <div class="login-brand">
        IT ELECTIVE - SSO
    </div>

    <div class="login-nav-links">

        <a href="/">
            Gateway
        </a>

        <a href="/">
            Home
        </a>

        <a href="/">
            External Apps
        </a>

        <a href="/">
            Privacy
        </a>

    </div>

</nav>

<main class="login-container">

    <section class="login-card"
             aria-labelledby="login-title">

        <header class="login-header">

            <h1 id="login-title">
                IT ELECTIVE - SSO
            </h1>

            <p>
                Single Sign-On Gateway
            </p>

        </header>

        @if (!string.IsNullOrWhiteSpace(appName))
        {
            <div class="app-name"
                 aria-label="Application requesting login">

                Sign in to <strong>@appName</strong>

            </div>
        }

        <div id="login-error"
             class="login-error"
             role="alert"
             aria-live="assertive"
             hidden>

            Invalid email or password.

        </div>

        <form method="post"
              action="/Auth/Login"
              aria-label="Login form">

            <input type="hidden"
                   name="returnUrl"
                   value="@returnUrl" />

            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <input type="email"
                       id="email"
                       name="email"
                       autocomplete="username"
                       aria-required="true"
                       aria-describedby="login-error"
                       required />

            </div>

            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input type="password"
                       id="password"
                       name="password"
                       autocomplete="current-password"
                       aria-required="true"
                       aria-describedby="login-error"
                       required />

            </div>

            <button type="submit"
                    class="login-button">

                Sign In

            </button>

        </form>

    </section>

</main>