@model LoginViewModel
@{
    ViewData["Title"] = "IT ELECTIVE - SSO";
    ViewData["IsLoginPage"] = true;

    // Errors come from AuthController (invalid credentials, rate limit, validation).
    var errors = ViewData.ModelState.Values
        .SelectMany(v => v.Errors)
        .Select(e => e.ErrorMessage)
        .Where(m => !string.IsNullOrWhiteSpace(m))
        .Distinct()
        .ToList();
}

<nav class="login-navbar"
     aria-label="Main navigation">

    <div class="login-brand">
        IT ELECTIVE - SSO
    </div>

    <div class="login-nav-links">

        <a href="/">
            Gateway
        </a>

        <a href="/">
            Home
        </a>

        <a href="/">
            External Apps
        </a>

        <a href="/">
            Privacy
        </a>

    </div>

</nav>

<main class="login-container">

    <section class="login-card"
             aria-labelledby="login-title">

        <header class="login-header">

            <h1 id="login-title">
                IT ELECTIVE - SSO
            </h1>

            <p>
                Single Sign-On Gateway
            </p>

        </header>

        @if (!string.IsNullOrWhiteSpace(Model.AppName))
        {
            <div class="app-name"
                 aria-label="Application requesting login">

                Sign in to <strong>@Model.AppName</strong>

            </div>
        }

        <div id="login-error"
             class="login-error"
             role="alert"
             aria-live="assertive"
             hidden="@(errors.Count == 0 ? "hidden" : null)">

            @foreach (var message in errors)
            {
                <div>@message</div>
            }

        </div>

        <form asp-controller="Auth"
              asp-action="Login"
              method="post"
              novalidate
              aria-label="Login form">

            <input asp-for="ReturnUrl"
                   type="hidden" />

            <div class="form-group">

                <label for="email">
                    Email
                </label>

                <input asp-for="Email"
                       type="email"
                       id="email"
                       autocomplete="username"
                       aria-required="true"
                       aria-describedby="login-error"
                       required />

            </div>

            <div class="form-group">

                <label for="password">
                    Password
                </label>

                <input asp-for="Password"
                       type="password"
                       id="password"
                       autocomplete="current-password"
                       aria-required="true"
                       aria-describedby="login-error"
                       required />

            </div>

            <button type="submit"
                    class="login-button">

                Sign In

            </button>

        </form>

    </section>

</main>
