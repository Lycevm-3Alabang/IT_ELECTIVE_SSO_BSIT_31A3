@model Gateway.Models.ExternalApp

@{
    ViewData["Title"] = "Delete Application";
}

<h2 class="text-danger">Delete Application</h2>
<p>Are you sure you want to delete this external app registration?</p>

<div class="card col-md-6 mb-3">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">App Name</dt>
            <dd class="col-sm-8">@Model.Name</dd>

            <dt class="col-sm-4">Return URL</dt>
            <dd class="col-sm-8"><code>@Model.ReturnUrl</code></dd>

            <dt class="col-sm-4">Status</dt>
            <dd class="col-sm-8">
                @(Model.IsEnabled ? "Active" : "Disabled")
            </dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Confirm Delete</button>
    <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
</form>