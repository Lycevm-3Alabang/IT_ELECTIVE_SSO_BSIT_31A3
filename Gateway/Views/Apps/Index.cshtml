@model IEnumerable<Gateway.Models.ExternalApp>

@{
    ViewData["Title"] = "External Apps";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>External Apps</h2>
            <p class="text-muted">
                Register and manage applications that can use SSO.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Register App
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <h5>No applications registered</h5>
                    <p class="text-muted">
                        Register an external application to get started.
                    </p>

                    <a asp-action="Create" class="btn btn-primary">
                        Register App
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Return URL</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr>
                                    <td>
                                        <strong>@app.Name</strong>
                                    </td>

                                    <td>
                                        <code>@app.ReturnUrl</code>
                                    </td>

                                    <td>
                                        @if (app.IsEnabled)
                                        {
                                            <span class="badge bg-success">
                                                Enabled
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Disabled
                                            </span>
                                        }
                                    </td>

                                    <td class="text-end">

                                        <a asp-action="Edit"
                                           asp-route-id="@app.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Edit
                                        </a>

                                        <form asp-action="Toggle"
                                              asp-route-id="@app.Id"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            @if (app.IsEnabled)
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-warning">
                                                    Disable
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-success">
                                                    Enable
                                                </button>
                                            }

                                        </form>

                                        <a asp-action="Delete"
                                           asp-route-id="@app.Id"
                                           class="btn btn-sm btn-outline-danger">
                                            Delete
                                        </a>

                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            }

        </div>
    </div>

</div>