@model Gateway.Models.Admin.AppListViewModel
@{
    ViewData["Title"] = "External Apps";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">External Apps</h1>
    <a class="btn btn-primary" asp-action="Create">Register New App</a>
</div>
<p class="text-muted">Register and manage applications that can use SSO.</p>

@if (TempData["StatusMessage"] is string statusMessage)
{
    <div class="alert alert-info">@statusMessage</div>
}

@Html.AntiForgeryToken()

@if (!Model.Apps.Any())
{
    <div class="text-center text-muted py-5">
        <p class="mb-3">No applications registered yet.</p>
        <a class="btn btn-primary" asp-action="Create">Register App</a>
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Application Name</th>
                <th>Return URL</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var app in Model.Apps)
            {
                <tr id="app-row-@app.Id">
                    <td><strong>@app.Name</strong></td>
                    <td><code>@app.ReturnUrl</code></td>
                    <td>
                        <span class="badge @(app.IsActive ? "bg-success" : "bg-secondary") app-status">
                            @(app.IsActive ? "Active" : "Disabled")
                        </span>
                    </td>
                    <td class="text-end">
                        <div class="d-flex justify-content-end align-items-center gap-3">
                            <div class="form-check form-switch mb-0" title="Toggle status">
                                <input class="form-check-input app-active-toggle"
                                       type="checkbox"
                                       role="switch"
                                       id="active-@app.Id"
                                       data-app-id="@app.Id"
                                       aria-label="Toggle status for @app.Name"
                                @(app.IsActive ? "checked" : "") />
                            </div>
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@app.Id">Edit</a>
                            <button type="button" class="btn btn-sm btn-outline-danger js-delete-trigger"
                                    data-bs-toggle="modal" data-bs-target="#deleteAppModal"
                                    data-delete-url="@Url.Action("Delete", new { id = app.Id })"
                                    data-app-name="@app.Name">
                                Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@await Html.PartialAsync("_DeleteConfirmModal")

@section Scripts {
    <script>
        (() => {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const toggleEndpoint = '@Url.Action("ToggleActive", "Apps")';

            // --- Toggle status (AJAX) ---
            document.querySelectorAll('.app-active-toggle').forEach(toggle => {
                toggle.addEventListener('change', async () => {
                    const previous = !toggle.checked;
                    toggle.disabled = true;

                    try {
                        const response = await fetch(`${toggleEndpoint}/${encodeURIComponent(toggle.dataset.appId)}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'RequestVerificationToken': token,
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        const data = await response.json();
                        if (!response.ok || !data.success) {
                            throw new Error(data.message || 'Unable to update app status.');
                        }

                        toggle.checked = data.isActive;
                        const row = toggle.closest('tr');
                        const status = row.querySelector('.app-status');
                        status.textContent = data.status;
                        status.classList.toggle('bg-success', data.isActive);
                        status.classList.toggle('bg-secondary', !data.isActive);
                    } catch (error) {
                        toggle.checked = previous;
                        alert(error.message || 'Unable to update app status.');
                    } finally {
                        toggle.disabled = false;
                    }
                });
            });

            // --- Delete confirmation modal ---
            const deleteForm = document.getElementById('deleteAppForm');
            const deleteNameLabel = document.getElementById('deleteAppModalName');

            document.querySelectorAll('.js-delete-trigger').forEach(button => {
                button.addEventListener('click', () => {
                    const deleteUrl = button.getAttribute('data-delete-url');
                    const name = button.getAttribute('data-app-name');

                    if (deleteForm) deleteForm.setAttribute('action', deleteUrl);
                    if (deleteNameLabel) deleteNameLabel.textContent = name || 'this app';
                });
            });
        })();
    </script>
}
