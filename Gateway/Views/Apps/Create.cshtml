@model Gateway.Models.ExternalApp

@{
    ViewData["Title"] = "Register App";
}

<div class="container mt-4">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="card shadow-sm">

                <div class="card-body p-4">

                    <h2 class="mb-1">Register External App</h2>

                    <p class="text-muted mb-4">
                        Add an application that can use SSO.
                    </p>

                    <form asp-action="Create" method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label asp-for="Name"
                                   class="form-label">
                                App Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Example: HR Portal" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="ReturnUrl"
                                   class="form-label">
                                Return URL
                            </label>

                            <input asp-for="ReturnUrl"
                                   class="form-control"
                                   placeholder="https://example.com/callback" />

                            <span asp-validation-for="ReturnUrl"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">
                                URL where the user will be returned after SSO.
                            </small>

                        </div>

                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-secondary">
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary">
                                Register App
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}