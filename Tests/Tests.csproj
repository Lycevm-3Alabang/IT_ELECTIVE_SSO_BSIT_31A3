<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- This project lives in the parent folder of Gateway.Tests and Data.Tests. Without this,
         the default **/*.cs glob would compile their files here too (duplicate types, missing references). -->
    <Compile Remove="Gateway.Tests\**;Data.Tests\**" />
    <EmbeddedResource Remove="Gateway.Tests\**;Data.Tests\**" />
    <None Remove="Gateway.Tests\**;Data.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>